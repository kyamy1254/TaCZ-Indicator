<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.kyamy.taczindicator</groupId>
    <artifactId>tacz-indicator</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>TaCZ Damage Indicator</name>
    <description>Distance-independent damage indicator mod for Minecraft Forge 1.20.1 with TaCZ support</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <minecraft.version>1.20.1</minecraft.version>
        <forge.version>47.2.0</forge.version>
    </properties>

    <repositories>
        <repository>
            <id>minecraftforge</id>
            <name>MinecraftForge Maven</name>
            <url>https://maven.minecraftforge.net/</url>
        </repository>
        <repository>
            <id>mojang</id>
            <name>Mojang Maven</name>
            <url>https://libraries.minecraft.net/</url>
        </repository>
        <repository>
            <id>spongepowered</id>
            <name>SpongePowered Maven</name>
            <url>https://repo.spongepowered.org/maven/</url>
        </repository>
        <repository>
            <id>cursemaven</id>
            <name>CurseMaven</name>
            <url>https://cursemaven.com</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Forge universal / launcher / core -->
        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>forge</artifactId>
            <version>${minecraft.version}-${forge.version}</version>
            <classifier>universal</classifier>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>fmlcore</artifactId>
            <version>${minecraft.version}-${forge.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>cpw.mods</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>net.jodah</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>fmlloader</artifactId>
            <version>${minecraft.version}-${forge.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>cpw.mods</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>net.jodah</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>eventbus</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>cpw.mods</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>net.jodah</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.minecraftforge</groupId>
            <artifactId>forgespi</artifactId>
            <version>7.0.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Netty / Network -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.1.97.Final</version>
            <scope>provided</scope>
        </dependency>

        <!-- JOML for 3D Math in 1.20.1 -->
        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
            <version>1.10.5</version>
            <scope>provided</scope>
        </dependency>

        <!-- Log4j2 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.20.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.20.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 for Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven Resources Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven Jar Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Specification-Title>taczindicator</Specification-Title>
                            <Specification-Vendor>Kyamy</Specification-Vendor>
                            <Specification-Version>1</Specification-Version>
                            <Implementation-Title>${project.name}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Implementation-Vendor>Kyamy</Implementation-Vendor>
                            <FMLModType>MOD</FMLModType>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Maven Surefire Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
        </plugins>
    </build>
</project>
